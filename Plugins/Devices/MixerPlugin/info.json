{
  "schema_version": 1,
  "id": 7,
  "name": "Mixer",
  "type": "dsp",
  "category": "Amps/Mixers",
  "authors": [
    "David Griffiths"
  ],
  "version": "2",
  "host": {
    "name": "SpiralSynthModular",
    "version": "0.3.1",
    "abi": "0.3.1"
  },
  "registration": "module",
  "module": "MixerPlugin_DSP.so",
  "ui": {
    "control_contracts": {
      "Controls": 1,
      "Meters": 1
    },
    "host_version": "0.3.43",
    "panel": {
      "auto_width": true,
      "children": [
        {
          "bounds": [
            -2,
            1,
            20,
            108
          ],
          "children": [
            {
              "bounds": [
                0,
                -8,
                20,
                20
              ],
              "latch": true,
              "name": "peak-{index}",
              "property": "PEAK",
              "tooltip": {
                "default": "Lit when the input peaks; click to clear",
                "key": "plugin.7.panel.peak-channel.tooltip"
              },
              "type": "Meters::LED"
            },
            {
              "bounds": [
                0,
                8,
                20,
                100
              ],
              "max": 2,
              "min": 0,
              "name": "volume-{index}",
              "on": {
                "value_changed": [
                  {
                    "clear": [
                      "peak-{index}",
                      "peak"
                    ]
                  }
                ]
              },
              "property": "VOLUME",
              "step": 0.01,
              "tooltip": "The input's level in the mix",
              "type": "Slider",
              "vertical": true
            }
          ],
          "name": "channels",
          "source": "channels",
          "step_x": 20,
          "type": "Repeat"
        },
        {
          "bounds": [
            -2,
            112,
            20,
            20
          ],
          "name": "remove",
          "on": {
            "pressed": [
              {
                "amount": -1,
                "delta": "CHANNELS"
              },
              {
                "clear": [
                  "peak"
                ]
              }
            ]
          },
          "text": "-",
          "tooltip": "One channel fewer, down to two",
          "type": "Button"
        },
        {
          "bounds": [
            18,
            112,
            20,
            20
          ],
          "name": "add",
          "on": {
            "pressed": [
              {
                "amount": 1,
                "delta": "CHANNELS"
              },
              {
                "clear": [
                  "peak"
                ]
              }
            ]
          },
          "text": "+",
          "tooltip": "One channel more, up to sixteen",
          "type": "Button"
        },
        {
          "bounds": [
            38,
            112,
            20,
            20
          ],
          "latch": true,
          "name": "peak",
          "property": "PEAK",
          "tooltip": "Lit when the mix peaks; click to clear",
          "type": "Meters::LED"
        }
      ],
      "height": 134,
      "help": "A slider per input mixed to the output, 0 to 2, with a lamp that lights and stays lit when the input peaks (click it, or move the slider, to clear). + and - add and remove inputs, two to sixteen; the lamp beside them is the output's peak.",
      "schema_version": 1,
      "sources": {
        "channels": {
          "count": "CHANNELS",
          "fields": [
            "VOLUME",
            "PEAK"
          ]
        }
      },
      "width": 76
    },
    "plugin_id": 7,
    "properties": [
      {
        "class": "StringProperty",
        "default": "",
        "display_name": "COMMAND",
        "hint": "Command",
        "internal": true,
        "omitted": "internal",
        "property": "COMMAND",
        "read_only": false,
        "type": "string"
      },
      {
        "class": "StringProperty",
        "default": "Mixer",
        "display_name": "DeviceType",
        "hint": "DeviceType",
        "internal": false,
        "omitted": "identity",
        "property": "DEVICETYPE",
        "read_only": true,
        "type": "string"
      },
      {
        "class": "UnsignedProperty",
        "default": 2,
        "display_name": "DeviceVersion",
        "hint": "DeviceVersion",
        "internal": false,
        "logarithmic": false,
        "max": 0,
        "min": 0,
        "omitted": "identity",
        "page": 0,
        "property": "DEVICEVERSION",
        "read_only": true,
        "step": 0,
        "type": "integer"
      }
    ],
    "schema_version": 1
  }
}
