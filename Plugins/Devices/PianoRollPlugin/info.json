            56,
            20
          ],
          "name": "thru",
          "property": "THRU",
          "text": "Thru",
          "type": "Basic::LEDButton"
        },
        {
          "bounds": [
            352,
            4,
            64,
            20
          ],
          "format": "%6.2f",
          "name": "position",
          "property": "POSITION",
          "size": 10,
          "type": "Meters::LCD"
        },
        {
          "bounds": [
            4,
            30,
            412,
            234
          ],
          "count": "NOTES",
          "grid": 0.25,
          "keys": 24,
          "low_key": 48,
          "name": "roll",
          "notes": "NoteRows",
          "on": {
            "note_added": [
              {
                "value": "ADD_NOTE",
                "with": [
                  "start",
                  "end",
                  "key",
                  "velocity"
                ],
                "write": "COMMAND"
              }
            ],
            "note_changed": [
              {
                "value": "EDIT_NOTE",
                "with": [
                  "index",
                  "start",
                  "end",
                  "key",
                  "velocity"
                ],
                "write": "COMMAND"
              }
            ],
            "note_removed": [
              {
                "value": "DELETE_NOTE",
                "with": [
                  "index"
                ],
                "write": "COMMAND"
              }
            ]
          },
          "playhead": "POSITION",
          "span": 4,
          "tooltip": "Click to add a note, drag to move it, drag an edge to resize, Delete removes the selected note. Wheel scrolls keys, Shift+wheel scrolls time.",
          "type": "Patch::PianoRoll"
        }
      ],
      "height": 268,
      "help": "A clip of notes played as events. Play, record from the event input, loop and edit the notes.",
