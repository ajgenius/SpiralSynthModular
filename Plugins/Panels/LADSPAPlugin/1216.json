{
  "comment": "A hand written panel for GVerb (swh-plugins, unique id 1216): the device's Panel page. Its inputs are the ones the generated pages would show, named as the plugin names them and written as their own command; the sliders are the Envelope's, and the Numbers tab is the same seven values to read and type.",
  "panel": {
    "schema_version": 1,
    "width": 320,
    "height": 190,
    "children": [
      {
        "type": "Notebook",
        "name": "pages",
        "bounds": [0, 0, 320, 190],
        "tab_height": 18,
        "page_padding": 4,
        "pages": [
          {
            "title": "Reverb",
            "children": [
              { "type": "Slider", "name": "room", "bounds": [6, 2, 20, 96],
                "property": "DEFAULT0", "mapping": "sqrt",
                "min": { "property": "MIN0" }, "max": { "property": "MAX0" },
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [0, "value"] }],
                "tooltip": { "default": "Roomsize (m)" } },
              { "type": "Label", "name": "room-label", "bounds": [-4, 100, 40, 12],
                "text": { "default": "Room" }, "size": 9 },

              { "type": "Slider", "name": "time", "bounds": [49, 2, 20, 96],
                "property": "DEFAULT1", "mapping": "sqrt",
                "min": { "property": "MIN1" }, "max": { "property": "MAX1" },
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [1, "value"] }],
                "tooltip": { "default": "Reverb time (s)" } },
              { "type": "Label", "name": "time-label", "bounds": [39, 100, 40, 12],
                "text": { "default": "Time" }, "size": 9 },

              { "type": "Slider", "name": "damping", "bounds": [92, 2, 20, 96],
                "property": "DEFAULT2",
                "min": { "property": "MIN2" }, "max": { "property": "MAX2" },
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [2, "value"] }],
                "tooltip": { "default": "Damping" } },
              { "type": "Label", "name": "damping-label", "bounds": [82, 100, 40, 12],
                "text": { "default": "Damp" }, "size": 9 },

              { "type": "Slider", "name": "bandwidth", "bounds": [135, 2, 20, 96],
                "property": "DEFAULT3",
                "min": { "property": "MIN3" }, "max": { "property": "MAX3" },
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [3, "value"] }],
                "tooltip": { "default": "Input bandwidth" } },
              { "type": "Label", "name": "bandwidth-label", "bounds": [125, 100, 40, 12],
                "text": { "default": "Band" }, "size": 9 },

              { "type": "Slider", "name": "dry", "bounds": [178, 2, 20, 96],
                "property": "DEFAULT4",
                "min": { "property": "MIN4" }, "max": { "property": "MAX4" },
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [4, "value"] }],
                "tooltip": { "default": "Dry signal level (dB)" } },
              { "type": "Label", "name": "dry-label", "bounds": [168, 100, 40, 12],
                "text": { "default": "Dry" }, "size": 9 },

              { "type": "Slider", "name": "early", "bounds": [221, 2, 20, 96],
                "property": "DEFAULT5",
                "min": { "property": "MIN5" }, "max": { "property": "MAX5" },
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [5, "value"] }],
                "tooltip": { "default": "Early reflection level (dB)" } },
              { "type": "Label", "name": "early-label", "bounds": [211, 100, 40, 12],
                "text": { "default": "Early" }, "size": 9 },

              { "type": "Slider", "name": "tail", "bounds": [264, 2, 20, 96],
                "property": "DEFAULT6",
                "min": { "property": "MIN6" }, "max": { "property": "MAX6" },
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [6, "value"] }],
                "tooltip": { "default": "Tail level (dB)" } },
              { "type": "Label", "name": "tail-label", "bounds": [254, 100, 40, 12],
                "text": { "default": "Tail" }, "size": 9 }
            ]
          },
          {
            "title": "Numbers",
            "children": [
              { "type": "Label", "name": "room-name", "bounds": [4, 2, 170, 16],
                "text": { "default": "Roomsize (m)" }, "size": 10, "align": "left" },
              { "type": "TextEntry", "name": "room-value", "bounds": [180, 2, 70, 16],
                "property": "DEFAULT0", "format": "%.2f", "box": "plastic",
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [0, "value"] }] },

              { "type": "Label", "name": "time-name", "bounds": [4, 23, 170, 16],
                "text": { "default": "Reverb time (s)" }, "size": 10, "align": "left" },
              { "type": "TextEntry", "name": "time-value", "bounds": [180, 23, 70, 16],
                "property": "DEFAULT1", "format": "%.2f", "box": "plastic",
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [1, "value"] }] },

              { "type": "Label", "name": "damping-name", "bounds": [4, 44, 170, 16],
                "text": { "default": "Damping" }, "size": 10, "align": "left" },
              { "type": "TextEntry", "name": "damping-value", "bounds": [180, 44, 70, 16],
                "property": "DEFAULT2", "format": "%.2f", "box": "plastic",
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [2, "value"] }] },

              { "type": "Label", "name": "bandwidth-name", "bounds": [4, 65, 170, 16],
                "text": { "default": "Input bandwidth" }, "size": 10, "align": "left" },
              { "type": "TextEntry", "name": "bandwidth-value", "bounds": [180, 65, 70, 16],
                "property": "DEFAULT3", "format": "%.2f", "box": "plastic",
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [3, "value"] }] },

              { "type": "Label", "name": "dry-name", "bounds": [4, 86, 170, 16],
                "text": { "default": "Dry signal level (dB)" }, "size": 10, "align": "left" },
              { "type": "TextEntry", "name": "dry-value", "bounds": [180, 86, 70, 16],
                "property": "DEFAULT4", "format": "%.2f", "box": "plastic",
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [4, "value"] }] },

              { "type": "Label", "name": "early-name", "bounds": [4, 107, 170, 16],
                "text": { "default": "Early reflection level (dB)" }, "size": 10, "align": "left" },
              { "type": "TextEntry", "name": "early-value", "bounds": [180, 107, 70, 16],
                "property": "DEFAULT5", "format": "%.2f", "box": "plastic",
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [5, "value"] }] },

              { "type": "Label", "name": "tail-name", "bounds": [4, 128, 170, 16],
                "text": { "default": "Tail level (dB)" }, "size": 10, "align": "left" },
              { "type": "TextEntry", "name": "tail-value", "bounds": [180, 128, 70, 16],
                "property": "DEFAULT6", "format": "%.2f", "box": "plastic",
                "write": [{ "property": "COMMAND", "value": "SETDEFAULT", "with": [6, "value"] }] }
            ]
          }
        ]
      }
    ]
  }
}
