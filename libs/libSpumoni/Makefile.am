# libSpumoni: the layered package library. A container (ZIP today) holding a
# manifest, save points as branch folders and their assets, knowing nothing
# of the application that fills it. Built as a convenience library and linked
# statically into libSSMCore. Headers in include/, sources in src/.
AM_CXXFLAGS = $(SSM_CXX03_FLAGS)
AM_CPPFLAGS = $(DEBUG_FLAGS) -I$(srcdir)/include -I$(top_srcdir)/Foundation/libSlick++
AUTOMAKE_OPTIONS = subdir-objects

noinst_LTLIBRARIES = libSpumoni.la
libSpumoni_la_SOURCES = \
	include/Container.h src/Container.cpp \
	include/Directory.h src/Directory.cpp \
	include/Folder.h src/Folder.cpp \
	include/Identity.h src/Identity.cpp \
	include/Package.h src/Package.cpp src/PackageVersion.cpp \
	include/Tar.h src/Tar.cpp \
	include/Zip.h src/Zip.cpp
libSpumoni_la_LIBADD = $(top_builddir)/Foundation/libSlick++/libSlick++.la $(ZLIB_LIBS)


check_PROGRAMS = spumoni-package-test
TESTS = spumoni-package-test
spumoni_package_test_SOURCES = tests/package.cpp
spumoni_package_test_LDADD = libSpumoni.la $(top_builddir)/Foundation/libSlick++/libSlick++.la $(ZLIB_LIBS)

# Build prerequisites before running this library's tests. Generated by ChatGPT.
TEST_DEPENDENCY_DIRS = libSlick++
include $(top_srcdir)/Foundation/test-target.am
