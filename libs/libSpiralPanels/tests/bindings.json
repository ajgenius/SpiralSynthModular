{
  "comment": "Binding semantics shared by SpiralSynthModular (libs/libspiralcore/Data) and SpiralTesting (Foundation/libSSMUI). Both trees' tests read this file; keep the two copies byte-identical. A case evaluates `binding` against `properties` and `controls` and must produce `expect`; an entry of `invalid` must be refused at load with the given reason, never evaluated.",
  "properties": {"RECORDING": 0, "PLAYING": 1, "MODE": 2, "LEVEL": 0.5, "COUNT": 3},
  "controls": {"meter": {"min": -12.5, "datum": 3}},
  "cases": [
    {"name": "literal true", "binding": true, "expect": true},
    {"name": "literal false", "binding": false, "expect": false},
    {"name": "a bare property is its truth: zero", "binding": {"property": "RECORDING"}, "expect": false},
    {"name": "a bare property is its truth: one", "binding": {"property": "PLAYING"}, "expect": true},
    {"name": "a bare property is its truth: a fraction is true", "binding": {"property": "LEVEL"}, "expect": true},
    {"name": "equals holds", "binding": {"property": "RECORDING", "equals": 0}, "expect": true},
    {"name": "equals fails", "binding": {"property": "MODE", "equals": 1}, "expect": false},
    {"name": "equals compares numbers exactly", "binding": {"property": "LEVEL", "equals": 0.5}, "expect": true},
    {"name": "not_equals", "binding": {"property": "MODE", "not_equals": 2}, "expect": false},
    {"name": "one_of hit", "binding": {"property": "MODE", "one_of": [1, 2]}, "expect": true},
    {"name": "one_of miss", "binding": {"property": "MODE", "one_of": [0, 1]}, "expect": false},
    {"name": "any: one case holds", "binding": {"any": [{"property": "RECORDING", "equals": 1}, {"property": "MODE", "equals": 2}]}, "expect": true},
    {"name": "any: no case holds", "binding": {"any": [{"property": "RECORDING", "equals": 1}, {"property": "MODE", "equals": 1}]}, "expect": false},
    {"name": "all: every case holds", "binding": {"all": [{"property": "RECORDING", "equals": 0}, {"property": "PLAYING"}]}, "expect": true},
    {"name": "all: one case fails", "binding": {"all": [{"property": "RECORDING", "equals": 0}, {"property": "MODE", "equals": 1}]}, "expect": false},
    {"name": "not", "binding": {"not": {"property": "PLAYING"}}, "expect": false},
    {"name": "not of a composite", "binding": {"not": {"any": [{"property": "RECORDING"}, {"property": "COUNT", "equals": 4}]}}, "expect": true},
    {"name": "text selected by truth: on", "binding": {"property": "PLAYING", "on": "@||", "off": "@>"}, "expect": "@||"},
    {"name": "text selected by truth: off", "binding": {"property": "RECORDING", "on": "@||", "off": "@>"}, "expect": "@>"},
    {"name": "a value from another control's attribute", "binding": {"control": "meter", "attribute": "min"}, "expect": -12.5},
    {"name": "an integer attribute", "binding": {"control": "meter", "attribute": "datum"}, "expect": 3}
  ],
  "invalid": [
    {"binding": {}, "reason": "no source"},
    {"binding": {"equals": 0}, "reason": "no source"},
    {"binding": {"property": "NOPE"}, "reason": "unknown property"},
    {"binding": {"property": "MODE", "equals": 1, "not_equals": 2}, "reason": "two comparisons"},
    {"binding": {"property": "MODE", "equals": 1, "bogus": 1}, "reason": "unknown key"},
    {"binding": {"property": "MODE", "one_of": 1}, "reason": "one_of is not an array"},
    {"binding": {"property": "PLAYING", "on": "x"}, "reason": "on without off"},
    {"binding": {"any": "x"}, "reason": "any is not an array"},
    {"binding": {"any": []}, "reason": "empty composite"},
    {"binding": {"any": [{"property": "MODE"}], "all": [{"property": "MODE"}]}, "reason": "two composites"},
    {"binding": {"control": "meter"}, "reason": "control without attribute"},
    {"binding": {"control": "nobody", "attribute": "min"}, "reason": "unknown control"},
    {"binding": {"control": "meter", "attribute": "nothing"}, "reason": "unknown attribute"},
    {"binding": 7, "reason": "not a literal or an object"},
    {"binding": "yes", "reason": "not a literal or an object"}
  ]
}
