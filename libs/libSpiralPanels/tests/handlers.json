{
  "comment": "The sink holds the properties' values; a delta changes one and returns it. Shared between SpiralSynthModular (libs/libspiralcore/Data/tests/handlers.json) and SpiralTesting (Foundation/libSSMUI/tests/handlers.json): keep byte-identical. Each case parses `on` (or a legacy `writes` list under `event`) against this scope, fires `fire.event` with `fire.arguments`, and expects the sink calls in order: `write PROPERTY VALUE [ARGS]`, `delta PROPERTY amount|factor N`, `set CONTROL ATTRIBUTE VALUE`, `clear CONTROL`.",
  "properties": {"COMMAND": 0, "GAIN": 1, "CHANNELS": 4, "NUMINPUTS": 2, "NUMOUTPUTS": 2, "PITCH": 440, "SWITCH POSITION": 0, "TIMEOUT": 30},
  "controls": {
    "meter": {"bypass": 1, "reset": 0},
    "loop": {"range_start": 100, "range_end": 200},
    "peak": {},
    "peak-3": {}
  },
  "events": {
    "pressed": ["value"],
    "on": ["value"],
    "off": ["value"],
    "value_changed": ["value", "text"],
    "filename_changed": ["text"],
    "activate": ["x", "y"],
    "deactivate": ["x", "y"],
    "volume": ["x", "y", "volume"]
  },
  "cases": [
    {"name": "a press sends a command",
     "on": {"pressed": [{"write": "COMMAND", "value": "RECORD"}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["write COMMAND RECORD []"]},
    {"name": "a press writes a number",
     "on": {"pressed": [{"write": "GAIN", "value": 1}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["write GAIN 1 []"]},
    {"name": "a write without a value writes the event's value",
     "on": {"value_changed": [{"write": "SWITCH POSITION"}]},
     "fire": {"event": "value_changed", "arguments": {"value": 2, "text": "2"}},
     "expect": ["write SWITCH POSITION 2 []"]},
    {"name": "a change sends a command with a constant and the value",
     "on": {"value_changed": [{"write": "COMMAND", "value": "SET_PATSEQ", "with": [0, "value"]}]},
     "fire": {"event": "value_changed", "arguments": {"value": 0.75, "text": "0.75"}},
     "expect": ["write COMMAND SET_PATSEQ [0,0.75]"]},
    {"name": "a change passes value and text",
     "on": {"value_changed": [{"write": "COMMAND", "value": "ADDCONTROL", "with": ["value", "text"]}]},
     "fire": {"event": "value_changed", "arguments": {"value": 7, "text": "Cutoff"}},
     "expect": ["write COMMAND ADDCONTROL [7,Cutoff]"]},
    {"name": "a press passes other controls' attributes",
     "on": {"pressed": [{"write": "COMMAND", "value": "CUT", "with": [3, {"control": "loop", "attribute": "range_start"}, {"control": "loop", "attribute": "range_end"}]}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["write COMMAND CUT [3,100,200]"]},
    {"name": "a chosen file passes its path",
     "on": {"filename_changed": [{"write": "COMMAND", "value": "LOAD", "with": ["text"]}]},
     "fire": {"event": "filename_changed", "arguments": {"text": "/tmp/a.wav"}},
     "expect": ["write COMMAND LOAD [/tmp/a.wav]"]},
    {"name": "a press bumps a property",
     "on": {"pressed": [{"delta": "CHANNELS", "amount": -1}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["delta CHANNELS amount -1"]},
    {"name": "a press bumps two properties",
     "on": {"pressed": [{"delta": ["NUMINPUTS", "NUMOUTPUTS"], "amount": 1}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["delta NUMINPUTS amount 1", "delta NUMOUTPUTS amount 1"]},
    {"name": "a press scales a property",
     "on": {"pressed": [{"delta": "PITCH", "factor": 0.5}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["delta PITCH factor 0.5"]},
    {"name": "a delta's result is the value the actions after it send",
     "on": {"pressed": [{"delta": "TIMEOUT", "amount": 1}, {"write": "COMMAND", "value": "SET_TIME", "with": ["value"]}, {"write": "GAIN"}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["delta TIMEOUT amount 1", "write COMMAND SET_TIME [31]", "write GAIN 31 []"]},
    {"name": "a change sets another control's attribute to the value",
     "on": {"value_changed": [{"set": "meter", "attribute": "bypass"}]},
     "fire": {"event": "value_changed", "arguments": {"value": 1, "text": "1"}},
     "expect": ["set meter bypass 1"]},
    {"name": "a press clears indicators",
     "on": {"pressed": [{"clear": ["peak", "peak-3"]}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["clear peak", "clear peak-3"]},
    {"name": "a grid activation passes its cell",
     "on": {"activate": [{"write": "COMMAND", "value": "MAT_ACTIVATE", "with": ["x", "y"]}]},
     "fire": {"event": "activate", "arguments": {"x": 2, "y": 5}},
     "expect": ["write COMMAND MAT_ACTIVATE [2,5]"]},
    {"name": "a grid volume passes cell and level",
     "on": {"volume": [{"write": "COMMAND", "value": "MAT_VOLUME", "with": ["x", "y", "volume"]}]},
     "fire": {"event": "volume", "arguments": {"x": 1, "y": 0, "volume": 0.5}},
     "expect": ["write COMMAND MAT_VOLUME [1,0,0.5]"]},
    {"name": "a toggle's off handlers run on off only",
     "on": {"on": [{"write": "COMMAND", "value": "RECORD"}], "off": [{"write": "COMMAND", "value": "STOP"}]},
     "fire": {"event": "off", "arguments": {"value": 0}},
     "expect": ["write COMMAND STOP []"]},
    {"name": "actions run in the order written",
     "on": {"pressed": [{"write": "GAIN", "value": 1}, {"clear": ["peak"]}, {"delta": "CHANNELS", "amount": 2}]},
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["write GAIN 1 []", "clear peak", "delta CHANNELS amount 2"]},
    {"name": "an event with no handlers does nothing",
     "on": {"pressed": [{"write": "GAIN", "value": 1}]},
     "fire": {"event": "value_changed", "arguments": {"value": 3, "text": "3"}},
     "expect": []},
    {"name": "a missing on is empty",
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": []},
    {"name": "the older write list reads as handlers of its event",
     "writes": [{"property": "COMMAND", "value": "SETREC", "with": [1]}, {"property": "GAIN", "value": 0}],
     "event": "pressed",
     "fire": {"event": "pressed", "arguments": {"value": 1}},
     "expect": ["write COMMAND SETREC [1]", "write GAIN 0 []"]},
    {"name": "the older write list carries the event's arguments",
     "writes": [{"property": "COMMAND", "value": "SET_TIME", "with": ["value"]}],
     "event": "value_changed",
     "fire": {"event": "value_changed", "arguments": {"value": 12, "text": "12"}},
     "expect": ["write COMMAND SET_TIME [12]"]}
  ],
  "invalid": [
    {"reason": "an undeclared event", "on": {"clicked": [{"write": "GAIN", "value": 1}]}},
    {"reason": "an argument the event does not carry", "on": {"pressed": [{"write": "COMMAND", "value": "X", "with": ["x"]}]}},
    {"reason": "an unknown property", "on": {"pressed": [{"write": "NOPE", "value": 1}]}},
    {"reason": "two verbs in one action", "on": {"pressed": [{"write": "GAIN", "value": 1, "clear": ["peak"]}]}},
    {"reason": "no verb at all", "on": {"pressed": [{"value": 1}]}},
    {"reason": "delta with amount and factor", "on": {"pressed": [{"delta": "PITCH", "amount": 1, "factor": 2}]}},
    {"reason": "delta with neither", "on": {"pressed": [{"delta": "PITCH"}]}},
    {"reason": "set on an unknown attribute", "on": {"value_changed": [{"set": "meter", "attribute": "nothing"}]}},
    {"reason": "clear of an unknown control", "on": {"pressed": [{"clear": ["nobody"]}]}},
    {"reason": "on that is not a map", "on": [{"write": "GAIN", "value": 1}]},
    {"reason": "an event with no actions", "on": {"pressed": []}},
    {"reason": "an unknown key in an action", "on": {"pressed": [{"write": "GAIN", "value": 1, "when": true}]}},
    {"reason": "an argument of the wrong shape", "on": {"pressed": [{"write": "COMMAND", "value": "X", "with": [{"control": "loop"}]}]}},
    {"reason": "an attribute argument on an unknown control", "on": {"pressed": [{"write": "COMMAND", "value": "X", "with": [{"control": "nobody", "attribute": "value"}]}]}},
    {"reason": "the older write list under an undeclared event", "writes": [{"property": "GAIN", "value": 1}], "event": "clicked"}
  ]
}
