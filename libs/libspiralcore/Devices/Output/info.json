          "text": "Volume",
          "type": "Label"
        },
        {
          "bounds": [
            2,
            68,
            30,
            15
          ],
          "choice": 1,
          "name": "mode-read",
          "on": {
            "off": [
              {
                "value": "CLOSE",
                "write": "COMMAND"
              }
            ],
            "on": [
              {
                "value": "CLOSE",
                "write": "COMMAND"
              },
              {
                "value": "OPENREAD",
                "write": "COMMAND"
              }
            ]
          },
          "property": "MODE",
          "text": "Read",
          "toggle": true,
          "type": "Button"
        },
        {
          "bounds": [
            34,
            68,
            31,
            15
          ],
          "choice": 3,
          "name": "mode-dplx",
          "on": {
            "off": [
              {
                "value": "CLOSE",
                "write": "COMMAND"
              }
            ],
            "on": [
              {
                "value": "CLOSE",
                "write": "COMMAND"
              },
              {
                "value": "OPENDUPLEX",
                "write": "COMMAND"
              }
            ]
          },
          "property": "MODE",
          "text": "Dplx",
          "toggle": true,
