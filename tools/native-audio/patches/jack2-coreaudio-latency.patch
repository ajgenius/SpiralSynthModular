diff --git a/macosx/coreaudio/JackCoreAudioLatency.h b/macosx/coreaudio/JackCoreAudioLatency.h
new file mode 100644
index 0000000..1fbd9a2
--- /dev/null
+++ b/macosx/coreaudio/JackCoreAudioLatency.h
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef JACK_CORE_AUDIO_LATENCY_H
+#define JACK_CORE_AUDIO_LATENCY_H
+
+#include <CoreAudio/CoreAudio.h>
+#include <cstddef>
+#include <climits>
+#include <vector>
+
+namespace Jack
+{
+inline OSStatus CoreAudioChannelCount(AudioDeviceID device, bool input, int &channels)
+{
+	channels = 0;
+	AudioObjectPropertyAddress address = {kAudioDevicePropertyStreamConfiguration,
+		input ? kAudioObjectPropertyScopeInput : kAudioObjectPropertyScopeOutput, 0};
+	UInt32 size = 0;
+	OSStatus error = AudioObjectGetPropertyDataSize(device, &address, 0, NULL, &size);
+	if (error != noErr) return error;
+
+	if (size < offsetof(AudioBufferList, mBuffers)) return kAudioHardwareBadPropertySizeError;
+
+	std::vector<char> storage(size);
+	error = AudioObjectGetPropertyData(device, &address, 0, NULL, &size, &storage[0]);
+	if (error != noErr) return error;
+
+	const AudioBufferList *buffers = reinterpret_cast<const AudioBufferList *>(&storage[0]);
+	if (size < offsetof(AudioBufferList, mBuffers) ||
+		buffers->mNumberBuffers > (size - offsetof(AudioBufferList, mBuffers)) / sizeof(AudioBuffer))
+		return kAudioHardwareBadPropertySizeError;
+
+	for (UInt32 n = 0; n < buffers->mNumberBuffers; ++n)
+	{
+		if (buffers->mBuffers[n].mNumberChannels > unsigned(INT_MAX - channels))
+			return kAudioHardwareIllegalOperationError;
+
+		channels += buffers->mBuffers[n].mNumberChannels;
+	}
+
+	return noErr;
+}
+
+inline OSStatus CoreAudioStreamLatencies(AudioDeviceID device, bool input, std::vector<UInt32> &latencies)
+{
+	latencies.clear();
+	int channels = 0;
+	OSStatus error = CoreAudioChannelCount(device, input, channels);
+	if (error != noErr || !channels) return error;
+
+	AudioObjectPropertyAddress address = {kAudioDevicePropertyStreams,
+		input ? kAudioObjectPropertyScopeInput : kAudioObjectPropertyScopeOutput, 0};
+	UInt32 size = 0;
+	error = AudioObjectGetPropertyDataSize(device, &address, 0, NULL, &size);
+	if (error != noErr) return error;
+
+	if (!size || size % sizeof(AudioStreamID)) return kAudioHardwareBadPropertySizeError;
+
+	std::vector<AudioStreamID> streams(size / sizeof(AudioStreamID));
+	error = AudioObjectGetPropertyData(device, &address, 0, NULL, &size, &streams[0]);
+	if (error != noErr) return error;
+
+	if (size % sizeof(AudioStreamID) || size / sizeof(AudioStreamID) > streams.size())
+		return kAudioHardwareBadPropertySizeError;
+
+	std::vector<UInt32> result(channels, 0);
+	std::vector<bool> assigned(channels, false);
+	for (unsigned n = 0; n < size / sizeof(AudioStreamID); ++n)
+	{
+		UInt32 first = 0, latency = 0, bytes = sizeof(first);
+		AudioStreamBasicDescription format;
+		address.mScope = kAudioObjectPropertyScopeGlobal;
+		address.mSelector = kAudioStreamPropertyStartingChannel;
+		error = AudioObjectGetPropertyData(streams[n], &address, 0, NULL, &bytes, &first);
+		if (error != noErr) return error;
+
+		address.mSelector = kAudioStreamPropertyVirtualFormat;
+		bytes = sizeof(format);
+		error = AudioObjectGetPropertyData(streams[n], &address, 0, NULL, &bytes, &format);
+		if (error != noErr) return error;
+
+		if (!first || first > unsigned(channels) || format.mChannelsPerFrame > unsigned(channels) - first + 1)
+			return kAudioHardwareIllegalOperationError;
+
+		address.mSelector = kAudioStreamPropertyLatency;
+		bytes = sizeof(latency);
+		error = AudioObjectGetPropertyData(streams[n], &address, 0, NULL, &bytes, &latency);
+		if (error != noErr) return error;
+
+		for (unsigned c = first - 1; c < first - 1 + format.mChannelsPerFrame; ++c)
+		{
+			if (assigned[c]) return kAudioHardwareIllegalOperationError;
+
+			result[c] = latency;
+			assigned[c] = true;
+		}
+
+	}
+
+	for (unsigned c = 0; c < assigned.size(); ++c)
+		if (!assigned[c]) return kAudioHardwareIllegalOperationError;
+
+	latencies.swap(result);
+	return noErr;
+}
+
+inline UInt32 CoreAudioPortLatency(UInt32 base, const std::vector<UInt32> &latencies,
+	const std::vector<int> &map, unsigned port)
+{
+	const int channel = map.empty() ? int(port) : (port < map.size() ? map[port] : -1);
+	if (channel < 0 || unsigned(channel) >= latencies.size()) return base;
+
+	const UInt32 extra = latencies[channel];
+	return extra > UINT_MAX - base ? UINT_MAX : base + extra;
+}
+}
+#endif
diff --git a/tests/testCoreAudioLatency.cpp b/tests/testCoreAudioLatency.cpp
new file mode 100644
index 0000000..6fece44
--- /dev/null
+++ b/tests/testCoreAudioLatency.cpp
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Exercise the real property reader without opening hardware.
+#include "../macosx/coreaudio/JackCoreAudioLatency.h"
+#include <cassert>
+#include <cstring>
+#include <cstdio>
+
+static bool failStream, malformed, noChannels;
+static UInt32 firstChannel = 3, lateFrames = 900;
+
+extern "C" OSStatus AudioObjectGetPropertyDataSize(AudioObjectID,
+	const AudioObjectPropertyAddress *address, UInt32, const void *, UInt32 *size)
+{
+	*size = address->mSelector == kAudioDevicePropertyStreams ? 3 * sizeof(AudioStreamID) :
+		offsetof(AudioBufferList, mBuffers) + 3 * sizeof(AudioBuffer);
+	return noErr;
+}
+
+extern "C" OSStatus AudioObjectGetPropertyData(AudioObjectID object,
+	const AudioObjectPropertyAddress *address, UInt32, const void *, UInt32 *size, void *data)
+{
+	if (address->mSelector == kAudioDevicePropertyStreamConfiguration)
+	{
+		std::memset(data, 0, *size);
+		AudioBufferList *list = static_cast<AudioBufferList *>(data);
+		list->mNumberBuffers = malformed ? 4 : (noChannels ? 0 : 3);
+		list->mBuffers[0].mNumberChannels = 2;
+		list->mBuffers[1].mNumberChannels = 2;
+		list->mBuffers[2].mNumberChannels = 1;
+		return noErr;
+	}
+
+	if (address->mSelector == kAudioDevicePropertyStreams)
+	{
+		const AudioStreamID streams[] = {10, 11, 12};
+		std::memcpy(data, streams, sizeof(streams));
+		return noErr;
+	}
+
+	assert(address->mScope == kAudioObjectPropertyScopeGlobal);
+	if (object == 12 && failStream) return kAudioHardwareBadObjectError;
+
+	if (address->mSelector == kAudioStreamPropertyVirtualFormat)
+	{
+		AudioStreamBasicDescription *format = static_cast<AudioStreamBasicDescription *>(data);
+		std::memset(format, 0, sizeof(*format));
+		format->mChannelsPerFrame = object == 12 ? 1 : 2;
+	}
+	else
+	{
+		UInt32 &value = *static_cast<UInt32 *>(data);
+		value = address->mSelector == kAudioStreamPropertyStartingChannel ?
+			(object == 10 ? firstChannel : (object == 11 ? 1 : 5)) :
+			(object == 10 ? lateFrames : (object == 11 ? 100 : 1000));
+	}
+
+	return noErr;
+}
+
+int main()
+{
+	std::vector<UInt32> latencies;
+	std::vector<int> map;
+	assert(Jack::CoreAudioStreamLatencies(1, false, latencies) == noErr);
+	assert(latencies.size() == 5);
+	assert(latencies[0] == 100 && latencies[1] == 100 && latencies[2] == 900 &&
+		latencies[3] == 900 && latencies[4] == 1000);
+	assert(Jack::CoreAudioPortLatency(512, latencies, map, 0) == 612);
+	assert(Jack::CoreAudioPortLatency(512, latencies, map, 1) == 612);
+	map.push_back(4);
+	map.push_back(0);
+	map.push_back(3);
+	assert(Jack::CoreAudioPortLatency(512, latencies, map, 0) == 1512);
+	assert(Jack::CoreAudioPortLatency(512, latencies, map, 1) == 612);
+	assert(Jack::CoreAudioPortLatency(512, latencies, map, 2) == 1412);
+	assert(Jack::CoreAudioPortLatency(512, latencies, map, 3) == 512);
+	assert(Jack::CoreAudioPortLatency(UINT_MAX - 1, latencies, map, 0) == UINT_MAX);
+
+	lateFrames = 950;
+	assert(Jack::CoreAudioStreamLatencies(1, true, latencies) == noErr && latencies[2] == 950);
+
+	failStream = true;
+	assert(Jack::CoreAudioStreamLatencies(1, true, latencies) != noErr && latencies.empty());
+	assert(Jack::CoreAudioPortLatency(512, latencies, map, 0) == 512);
+	failStream = false;
+	firstChannel = 0;
+	assert(Jack::CoreAudioStreamLatencies(1, true, latencies) != noErr && latencies.empty());
+	firstChannel = 4;
+	assert(Jack::CoreAudioStreamLatencies(1, true, latencies) != noErr && latencies.empty());
+	firstChannel = 5;
+	assert(Jack::CoreAudioStreamLatencies(1, true, latencies) != noErr && latencies.empty());
+	malformed = true;
+	assert(Jack::CoreAudioStreamLatencies(1, true, latencies) != noErr && latencies.empty());
+	malformed = false;
+	noChannels = true;
+	assert(Jack::CoreAudioStreamLatencies(1, true, latencies) == noErr && latencies.empty());
+	std::puts("CoreAudio channel layout, remapping, independent latency and failed queries PASS");
+}
