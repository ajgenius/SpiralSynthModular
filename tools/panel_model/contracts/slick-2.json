{
  "namespace": "Slick",
  "version": 2,
  "controls": {
    "Control": {
      "abstract": true,
      "required": ["bounds"],
      "attributes": {
        "bounds": ["array"],
        "enabled": ["binding", "boolean"],
        "if_property": ["string"],
        "name": ["string"],
        "on": ["handlers"],
        "tooltip": ["text"],
        "value": ["binding"],
        "visible": ["binding", "boolean"]
      }
    },
    "Container": {
      "extends": "Slick::Control",
      "abstract": true,
      "attributes": {
        "children": ["nodes"]
      }
    },
    "ValueControl": {
      "extends": "Slick::Control",
      "abstract": true,
      "attributes": {
        "mapping": ["object", "string"],
        "max": ["number", "object"],
        "min": ["number", "object"],
        "page": ["number"],
        "property": ["string"],
        "step": ["number"]
      }
    },
    "Knob": {
      "extends": "Slick::ValueControl",
      "attributes": {
        "scale_ticks": ["integer"],
        "style": ["string"]
      }
    },
    "Slider": {
      "extends": "Slick::ValueControl",
      "attributes": {
        "inverted": ["boolean"],
        "show_trough": ["boolean"],
        "style": ["string"],
        "value_label": ["string"],
        "vertical": ["boolean"]
      }
    },
    "Spinner": {
      "extends": "Slick::ValueControl",
      "attributes": {
        "box": ["string"],
        "digits": ["integer"],
        "simple": ["boolean"],
        "size": ["integer"]
      }
    },
    "Button": {
      "extends": "Slick::Control",
      "attributes": {
        "box": ["string"],
        "choice": ["integer"],
        "color_role": ["string"],
        "file": ["object"],
        "label": ["string"],
        "list": ["object"],
        "max": ["integer"],
        "min": ["integer"],
        "pressed": ["boolean"],
        "property": ["string"],
        "repeat": ["boolean"],
        "size": ["integer"],
        "text": ["binding", "text"],
        "toggle": ["boolean"]
      }
    },
    "RadioButton": {
      "extends": "Slick::Control",
      "attributes": {
        "choice": ["integer"],
        "glyph": ["string"],
        "property": ["string"],
        "text": ["binding", "text"]
      }
    },
    "CheckBox": {
      "extends": "Slick::Control",
      "attributes": {
        "property": ["string"],
        "size": ["integer"],
        "text": ["binding", "text"]
      }
    },
    "Choice": {
      "extends": "Slick::Control",
      "attributes": {
        "items": ["array"],
        "property": ["string"],
        "size": ["integer"]
      }
    },
    "Label": {
      "extends": "Slick::Control",
      "attributes": {
        "align": ["string"],
        "property": ["string"],
        "size": ["integer"],
        "text": ["binding", "text"],
        "texts": ["array"]
      }
    },
    "TextEntry": {
      "extends": "Slick::Control",
      "attributes": {
        "box": ["string"],
        "format": ["string"],
        "property": ["string"]
      }
    },
    "Notebook": {
      "extends": "Slick::Control",
      "attributes": {
        "page_padding": ["integer"],
        "pages": ["pages"],
        "tab_height": ["integer"]
      }
    },
    "VirtualScrollArea": {
      "extends": "Slick::Container",
      "attributes": {
        "always": ["boolean"],
        "box": ["string"],
        "content_size": ["array"],
        "horizontal": ["boolean"],
        "show_horizontal": ["boolean"],
        "vertical": ["boolean"],
        "view": ["array"]
      }
    },
    "Repeat": {
      "extends": "Slick::Container",
      "attributes": {
        "children": ["template"],
        "count_property": ["string"],
        "items": ["array"],
        "max_count": ["integer"],
        "step_x": ["integer"],
        "step_y": ["integer"]
      }
    }
  }
}
