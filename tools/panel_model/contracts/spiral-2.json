{
  "namespace": "Spiral",
  "version": 2,
  "controls": {
    "LCD": {
      "extends": "Slick::TextEntry",
      "attributes": {
        "placeholder": ["string"],
        "size": ["integer"]
      }
    },
    "LED": {
      "extends": "Slick::Control",
      "attributes": {
        "choice": ["integer"],
        "color_role": ["string"],
        "latch": ["boolean"],
        "property": ["string"]
      }
    },
    "LEDButton": {
      "extends": "Slick::Control",
      "attributes": {
        "bordered": ["boolean"],
        "choice": ["integer"],
        "color_role": ["string"],
        "down": ["boolean"],
        "property": ["string"],
        "size": ["integer"],
        "text": ["binding", "text"],
        "toggle": ["boolean"]
      }
    },
    "SevenSegment": {
      "extends": "Slick::Control",
      "attributes": {
        "digits": ["integer"],
        "format": ["string"],
        "property": ["string"]
      }
    },
    "Scope": {
      "extends": "Slick::Control",
      "attributes": {
        "samples": ["object"],
        "time_base": ["integer"]
      }
    },
    "FunctionPlot": {
      "extends": "Slick::Control",
      "attributes": {
        "samples": ["object"]
      }
    },
    "MeterBar": {
      "extends": "Slick::Control",
      "attributes": {
        "property": ["string"],
        "samples": ["object"]
      }
    },
    "EnvelopeCurve": {
      "extends": "Slick::Control",
      "attributes": {
        "length": ["object"],
        "mode": ["object"],
        "playhead": ["object"],
        "points": ["object"]
      }
    },
    "PianoKeys": {
      "extends": "Slick::Control",
      "attributes": {
        "first_note": ["integer"],
        "labels": ["boolean"],
        "note_count": ["integer"],
        "note_off": ["string"],
        "note_on": ["string"],
        "notes": ["object"],
        "toggle_mode": ["boolean"],
        "white_key_width": ["integer"]
      }
    },
    "SampleWaveform": {
      "extends": "Slick::Control",
      "attributes": {
        "loop_end": ["string"],
        "loop_start": ["string"],
        "play_start": ["string"],
        "pos": ["string"],
        "sample": ["object"]
      }
    },
    "MatrixGrid": {
      "extends": "Slick::Control",
      "attributes": {
        "columns": ["integer"],
        "grid": ["string"],
        "note_names": ["integer"],
        "rows": ["integer"],
        "scheme": ["string"],
        "step": ["string"],
        "volume": ["string"]
      }
    },
    "LoopWaveform": {
      "extends": "Slick::Control",
      "attributes": {
        "length": ["string"],
        "pos": ["string"],
        "sample": ["object"],
        "triggers": ["object"]
      }
    },
    "ValueTable": {
      "extends": "Slick::Control",
      "attributes": {
        "columns": ["integer"],
        "count": ["string"],
        "max": ["integer"],
        "min": ["integer"],
        "position": ["string"],
        "row_height": ["integer"],
        "set": ["string"],
        "values": ["string"]
      }
    },
    "PortList": {
      "extends": "Slick::Control",
      "attributes": {
        "connected": ["string"],
        "inputs": ["object"],
        "list": ["string"],
        "outputs": ["object"],
        "refresh": ["string"]
      }
    }
  }
}
